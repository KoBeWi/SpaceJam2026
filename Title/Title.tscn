[gd_scene format=3 uid="uid://bvsjr5kk2hsxi"]

[ext_resource type="FontFile" uid="uid://dx0waiphhqys2" path="res://Title/GHOSTS ITALIC PERSONAL USE.ttf" id="1_c0y8y"]

[sub_resource type="GDScript" id="GDScript_c0y8y"]
script/source = "extends Control

@onready var label: Label = $Label
@onready var label_original: Vector2 = $Label.position

func _ready() -> void:
	add_level(\"Mosaic\", \"Open Space\")
	add_level(\"Maze\", \"Abandoned Corridors\")
	add_level(\"Worm\", \"Common Basement\")
	add_level(\"Rings\", \"Underground Spiral\")
	add_level(\"Tworooms\", \"Double Rooms\")
	add_level(\"Mess\", \"Cave\")

func _process(delta: float) -> void:
	label.position = label_original + Vector2(randf_range(-1, 1), randf_range(-1, 1))

func add_level(plik_nazwa: String, true_nazwa: String):
	var button := Button.new()
	button.text = true_nazwa
	%Levels.add_child(button)
	button.pressed.connect(start_level.bind(plik_nazwa))

func start_level(plik: String):
	var game: Node = preload(\"uid://b5hp5r2gpuwqx\").instantiate()
	game.level = load(\"res://Levels/%s.tscn\" % plik)
	get_tree().change_scene_to_node(game)
	
"

