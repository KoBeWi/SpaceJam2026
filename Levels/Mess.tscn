[sub_resource type="GDScript" id="GDScript_trtwh"]
script/source = "extends Node3D

func _ready() -> void:
	get_parent().get_node(\"Ghost\").speed += 0.5
"

[sub_resource type="GDScript" id="GDScript_h6xx3"]
script/source = "extends Node3D

@export var process_material: ParticleProcessMaterial

func _ready():
	for light: OmniLight3D in get_children():
		light.light_color = Color.ROYAL_BLUE
		light.get_node(\"GPUParticles3D\").process_material = process_material
"

