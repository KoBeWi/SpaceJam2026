[sub_resource type="GDScript" id="GDScript_bvhbk"]
script/source = "extends \"res://GhostBox.gd\"

@onready var player: Node3D = owner.get_parent().get_node(\"Player\")

func _physics_process(delta: float) -> void:
	var radiance := 3.0 / player.global_position.distance_to(global_position)
	if radiance >= 0.8:
		owner.radiance += radiance * delta
	
	if owner.radiance >= 100:
		owner.get_parent().over_game()
"

