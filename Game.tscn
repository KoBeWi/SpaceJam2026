[sub_resource type="Shader" id="Shader_gwjdr"]
code = "shader_type canvas_item;

uniform float beep : hint_range(0.0, 1.0, 0.01);

void fragment() {
	COLOR.rgb = mix(COLOR.rgb, vec3(1, 1, 1), mod(UV.x - beep, 1));
}
"

